@{
    ViewData["Title"] = "Confirmar reserva";
    var reserva = ViewBag.Reserva as AirportApp.Models.Commerce.SeatReservation;
    var vuelo = ViewBag.Vuelo as AirportApp.Models.Flight;
    var asiento = ViewBag.Asiento as AirportApp.Models.Commerce.Seat;
    var claseCss = asiento?.SeatClass switch
    {
        "First" => "bg-soft-primary text-primary",
        "Business" => "bg-soft-warning text-warning-emphasis",
        _ => "bg-soft-neutral text-secondary",
    };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Inicio</a></li>
        <li class="breadcrumb-item"><a asp-controller="Flights" asp-action="Index">Vuelos</a></li>
        <li class="breadcrumb-item active" aria-current="page">Confirmar reserva</li>
    </ol>
</nav>

<div class="page-header">
    <h1>Confirmar reserva</h1>
    <p class="lead-muted">Revisa los detalles de tu vuelo antes de crear la orden.</p>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="table-card p-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="stat-icon bg-soft-primary text-primary" style="width:3.5rem;height:3.5rem;font-size:1.5rem;">
                    <i class="bi bi-airplane"></i>
                </div>
                <div>
                    <h3 class="mb-1">Vuelo @vuelo?.Flightno</h3>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-soft-primary fs-6">@vuelo?.FromNavigation?.Iata</span>
                        <i class="bi bi-arrow-right text-muted"></i>
                        <span class="badge bg-soft-primary fs-6">@vuelo?.ToNavigation?.Iata</span>
                    </div>
                </div>
            </div>

            <div class="detail-list">
                <div class="detail-item">
                    <dt>Asiento</dt>
                    <dd class="d-flex align-items-center gap-2">
                        <span class="badge @claseCss">@asiento?.SeatNo</span>
                        <span class="small text-muted">@asiento?.SeatClass</span>
                    </dd>
                </div>
                <div class="detail-item">
                    <dt>Precio del asiento</dt>
                    <dd>$@asiento?.Price.ToString("N2")</dd>
                </div>
                <div class="detail-item">
                    <dt>Fecha de salida</dt>
                    <dd>@vuelo?.Departure</dd>
                </div>
                <div class="detail-item">
                    <dt>Aeronave</dt>
                    <dd>@vuelo?.Airplane?.AirplaneId · cap. @vuelo?.Airplane?.Capacity</dd>
                </div>
                <div class="detail-item">
                    <dt>Reserva temporal</dt>
                    <dd class="text-warning-emphasis">
                        <i class="bi bi-clock me-1"></i>Vence a las @reserva?.ExpiresAt.ToLocalTime().ToString("HH:mm")
                    </dd>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title d-flex align-items-center gap-2">
                    <i class="bi bi-bag-check text-primary"></i>Resumen
                </h5>
                <hr class="my-3" style="border-color: var(--p-color-border);" />
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted">Total a pagar</span>
                    <span class="stat-value" style="font-size:1.5rem;">$@asiento?.Price.ToString("N2")</span>
                </div>
                <div class="alert alert-primary small mt-3 mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle"></i>
                    <div>Al crear la orden esta reserva se confirma y queda pendiente de pago.</div>
                </div>
            </div>
            <div class="card-footer bg-transparent d-flex flex-column gap-2" style="border-top:1px solid var(--p-color-border);">
                <form asp-action="CrearOrden" method="post" class="w-100">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="reservaId" value="@reserva?.SeatReservationId" />
                    <button type="submit" class="btn btn-primary w-100 btn-icon">
                        <i class="bi bi-bag-check"></i>Crear orden
                    </button>
                </form>
                <a asp-action="Asientos" asp-route-id="@reserva?.FlightId" class="btn btn-secondary w-100 btn-icon">
                    <i class="bi bi-arrow-left"></i>Cambiar asiento
                </a>
            </div>
        </div>
    </div>
</div>
