@model IEnumerable<AirportApp.Models.Commerce.Order>
@{
    ViewData["Title"] = "Historial de órdenes";
}

<div class="page-header">
    <h1>Historial de órdenes</h1>
    <p class="lead-muted">Consulta el estado de todas tus órdenes y pagos.</p>
</div>

@if (!Model.Any())
{
    <div class="table-card">
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-clock-history"></i></div>
            <h5>No tienes órdenes todavía</h5>
            <p>Cuando completes una reserva, aparecerá aquí en tu historial.</p>
            <a asp-controller="Flights" asp-action="Index" class="btn btn-primary btn-icon">
                <i class="bi bi-search"></i>Buscar vuelo
            </a>
        </div>
    </div>
}
else
{
    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Fecha</th>
                        <th>Detalle</th>
                        <th class="text-end">Total</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td><span class="badge bg-soft-neutral">@o.OrderId</span></td>
                            <td>@o.CreatedAt.ToLocalTime()</td>
                            <td>
                                @foreach (var d in o.Details)
                                {
                                    <div class="small">@d.Description</div>
                                }
                            </td>
                            <td class="text-end fw-semibold">$@o.Total.ToString("N2")</td>
                            <td>
                                @switch (o.Status)
                                {
                                    case "Pendiente":
                                        <span class="badge bg-soft-warning">Pendiente</span>
                                        break;
                                    case "Aprobado":
                                        <span class="badge bg-soft-success">Aprobado</span>
                                        break;
                                    case "Cancelado":
                                        <span class="badge bg-soft-danger">Cancelado</span>
                                        break;
                                    case "Rechazado":
                                        <span class="badge bg-soft-neutral">Rechazado</span>
                                        break;
                                    case "Fallido":
                                        <span class="badge bg-soft-danger">Fallido</span>
                                        break;
                                    default:
                                        <span class="badge bg-soft-neutral">@o.Status</span>
                                        break;
                                }
                            </td>
                            <td class="actions-cell text-end">
                                @if (o.Status == "Pendiente")
                                {
                                    <a class="btn btn-primary btn-sm" asp-action="Pago" asp-route-id="@o.OrderId">Pagar</a>
                                }
                                else
                                {
                                    <a class="btn btn-secondary btn-sm" asp-action="Pago" asp-route-id="@o.OrderId">Ver</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
