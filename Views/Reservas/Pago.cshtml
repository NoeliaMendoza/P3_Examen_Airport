@model AirportApp.Models.Commerce.Order
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Pago de la orden";
    var pagos = ViewBag.Pagos as List<AirportApp.Models.Commerce.Payment> ?? new();
    var badgeClase = Model.Status switch
    {
        "Pendiente" => "bg-soft-warning",
        "Aprobado" => "bg-soft-success",
        "Cancelado" or "Fallido" => "bg-soft-danger",
        "Rechazado" => "bg-soft-neutral",
        _ => "bg-soft-neutral",
    };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Historial">Mis órdenes</a></li>
        <li class="breadcrumb-item active" aria-current="page">Pago de la orden</li>
    </ol>
</nav>

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1>Pago de la orden #@Model.OrderId</h1>
        <p class="lead-muted">Confirma el pago para completar la reserva de tu asiento.</p>
    </div>
    <span class="badge @badgeClase fs-6"><i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i>@Model.Status</span>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle"></i><div>@TempData["Error"]</div>
    </div>
}
@if (TempData["Ok"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle"></i><div>@TempData["Ok"]</div>
    </div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="table-card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-receipt text-primary"></i>Detalle de la orden
            </div>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Descripción</th>
                            <th class="text-center">Cantidad</th>
                            <th class="text-end">Precio unitario</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Details)
                        {
                            <tr>
                                <td>@d.Description</td>
                                <td class="text-center">@d.Quantity</td>
                                <td class="text-end">$@d.UnitPrice.ToString("N2")</td>
                                <td class="text-end">$@d.Subtotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Total</th>
                            <th class="text-end" style="color: var(--p-color-primary);">$@Model.Total.ToString("N2")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        @if (pagos.Any())
        {
            <div class="table-card mt-3">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-primary"></i>Intentos de pago
                </div>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Pasarela</th>
                                <th>Transacción</th>
                                <th>Fecha</th>
                                <th>Monto</th>
                                <th>Estado</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in pagos)
                            {
                                var pBadge = p.Status switch
                                {
                                    "Aprobado" => "bg-soft-success",
                                    "Pendiente" => "bg-soft-warning",
                                    "Cancelado" or "Fallido" => "bg-soft-danger",
                                    _ => "bg-soft-neutral",
                                };
                                <tr>
                                    <td>
                                        <span class="badge bg-soft-neutral">
                                            @if (p.Gateway == "PayPal")
                                            {
                                                <i class="bi bi-paypal me-1"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-phone me-1"></i>
                                            }
                                            @p.Gateway
                                        </span>
                                    </td>
                                    <td><code class="small">@(p.ExternalTransactionId ?? "-")</code></td>
                                    <td>@p.CreationDate.ToLocalTime()</td>
                                    <td>$@p.Amount.ToString("N2")</td>
                                    <td><span class="badge @pBadge">@p.Status</span></td>
                                    <td class="text-end">
                                        @if (p.Gateway == "PayPal" && p.Status == "Pendiente" && !string.IsNullOrWhiteSpace(p.ApprovalUrl))
                                        {
                                            <a href="@p.ApprovalUrl" target="_blank" class="btn btn-primary btn-sm btn-icon">
                                                <i class="bi bi-box-arrow-up-right"></i>Continuar en PayPal
                                            </a>
                                        }
                                        else if (p.Gateway == "PayPhone" && p.Status == "Pendiente" && !string.IsNullOrWhiteSpace(p.ApprovalUrl))
                                        {
                                            <a href="@p.ApprovalUrl" target="_blank" class="btn btn-primary btn-sm btn-icon">
                                                <i class="bi bi-box-arrow-up-right"></i>Abrir link de pago
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title d-flex align-items-center gap-2">
                    <i class="bi bi-credit-card text-primary"></i>Elegir pasarela
                </h5>
                <p class="small text-muted">Paga con PayPal Sandbox o genera un link de pago con PayPhone (ambiente de pruebas).</p>

                @if (Model.Status == "Pendiente")
                {
                    <div id="paypal-button-container" class="mb-2"></div>
                    <div id="paypal-message" class="mb-2"></div>

                    <hr class="my-3">

                    <form asp-action="CrearPagoPayPhone" method="post" class="d-grid gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.OrderId" />
                        <button type="submit" class="btn btn-payphone btn-icon justify-content-center">
                            <i class="bi bi-phone"></i>Generar link PayPhone
                        </button>
                    </form>
                }
                else
                {
                    <div class="alert alert-success small d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-check-circle"></i>
                        <div>Esta orden ya fue procesada (estado <strong>@Model.Status</strong>).</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.Status == "Pendiente")
    {
        <script src="https://www.paypal.com/sdk/js?client-id=@Configuration["PayPal:ClientId"]&currency=USD&components=buttons&enable-funding=card"></script>

        <script>
            let paymentTransactionId = 0;

            function showPayPalMessage(message, type) {
                document.getElementById('paypal-message').innerHTML =
                    '<div class="alert alert-' + type + '">' + message + '</div>';
            }

            if (typeof paypal !== 'undefined') {
                paypal.Buttons({
                    createOrder: function () {
                        return fetch('/Reservas/CreatePayPalButtonOrderJson?orderId=@Model.OrderId', {
                            method: 'POST'
                        })
                            .then(response => response.json())
                            .then(data => {
                                if (!data.success) {
                                    showPayPalMessage(data.message, 'danger');
                                    throw new Error(data.message);
                                }

                                paymentTransactionId = data.paymentTransactionId;
                                return data.paypalOrderId;
                            });
                    },

                    onApprove: function (data) {
                        return fetch('/Reservas/CapturePayPalButtonOrderJson', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                paypalOrderId: data.orderID,
                                paymentTransactionId: paymentTransactionId
                            })
                        })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    window.location.href = data.redirectUrl;
                                } else {
                                    showPayPalMessage(data.message, 'danger');
                                }
                            });
                    },

                    onCancel: function () {
                        showPayPalMessage('Pago cancelado por el usuario.', 'warning');
                    },

                    onError: function (err) {
                        console.error(err);
                        showPayPalMessage('Ocurrió un error con PayPal Sandbox.', 'danger');
                    }
                }).render('#paypal-button-container');
            } else {
                showPayPalMessage('No se pudo cargar el botón de PayPal. Revisa las credenciales.', 'danger');
            }
        </script>
    }
}
