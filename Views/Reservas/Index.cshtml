@model IEnumerable<AirportApp.Models.Commerce.SeatReservation>
@{
    ViewData["Title"] = "Mis reservas temporales";
}

<div class="page-header">
    <h1>Mis reservas</h1>
    <p class="lead-muted">Reservas temporales de asientos. Cada reserva vence en 10 minutos.</p>
</div>

@if (!Model.Any())
{
    <div class="table-card">
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-ticket-perforated"></i></div>
            <h5>Aún no tienes reservas</h5>
            <p>Busca un vuelo y selecciona tu asiento para comenzar.</p>
            <a asp-controller="Flights" asp-action="Index" class="btn btn-primary btn-icon">
                <i class="bi bi-search"></i>Buscar vuelo
            </a>
        </div>
    </div>
}
else
{
    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Vuelo</th>
                        <th>Asiento</th>
                        <th>Reservado</th>
                        <th>Vence</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td><span class="badge bg-soft-primary">#@r.FlightId</span></td>
                            <td><span class="badge bg-soft-neutral">#@r.SeatId</span></td>
                            <td>@r.ReservedAt.ToLocalTime()</td>
                            <td>@r.ExpiresAt.ToLocalTime()</td>
                            <td>
                                @if (r.IsConfirmed)
                                {
                                    <span class="badge bg-soft-success">Confirmada</span>
                                }
                                else if (r.ExpiresAt <= DateTime.UtcNow)
                                {
                                    <span class="badge bg-soft-danger">Expirada</span>
                                }
                                else
                                {
                                    <span class="badge bg-soft-warning">Activa</span>
                                }
                            </td>
                            <td class="actions-cell text-end">
                                @if (!r.IsConfirmed && r.ExpiresAt > DateTime.UtcNow)
                                {
                                    <a asp-action="Checkout" asp-route-reservaId="@r.SeatReservationId" class="btn btn-primary btn-sm">
                                        Continuar
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
