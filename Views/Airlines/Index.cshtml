@model IEnumerable<AirportApp.Models.Airline>
@using AirportApp.ViewModels

@{
    ViewData["Title"] = "Aerolíneas";
    var pag = ViewBag.Paginacion as PaginacionViewModel;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Aerolíneas</li>
    </ol>
</nav>

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1>Aerolíneas</h1>
        <p class="lead-muted">Gestiona el catálogo de aerolíneas del aeropuerto.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-icon">
        <i class="bi bi-plus-lg"></i>Nueva aerolínea
    </a>
</div>

<div class="filter-panel">
    <form asp-action="Index" method="get">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label" for="buscar">Buscar</label>
                <div class="search-input">
                    <i class="bi bi-search"></i>
                    <input type="text" id="buscar" name="buscar" value="@pag?.Buscar"
                           class="form-control" placeholder="Buscar por nombre o código IATA" />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="filtro1">Aeropuerto base</label>
                <select id="filtro1" name="filtro1" class="form-select">
                    <option value="">Todos los aeropuertos base</option>
                    @foreach (var a in ViewBag.Aeropuertos)
                    {
                        <option value="@a.Value" selected="@(pag?.Filtro1 == a.Value)">@a.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="orden">Ordenar por</label>
                <select id="orden" name="orden" class="form-select">
                    <option value="id" selected="@(pag?.Orden == "id" || pag?.Orden == null)">ID</option>
                    <option value="nombre" selected="@(pag?.Orden == "nombre")">Nombre</option>
                    <option value="iata" selected="@(pag?.Orden == "iata")">IATA</option>
                </select>
            </div>
            <div class="col-md-2 d-flex flex-column gap-2 justify-content-end">
                <button type="submit" class="btn btn-primary btn-icon">
                    <i class="bi bi-funnel"></i>Filtrar
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-icon">
                    <i class="bi bi-arrow-counterclockwise"></i>Limpiar
                </a>
            </div>
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <div class="table-card">
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-airplane-engines"></i></div>
            <h5>Sin resultados</h5>
            <p>No se encontraron aerolíneas con los criterios indicados. Ajusta los filtros e inténtalo de nuevo.</p>
            <a asp-action="Index" class="btn btn-secondary btn-sm">Limpiar filtros</a>
        </div>
    </div>
}
else
{
    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Iata)</th>
                        <th>@Html.DisplayNameFor(model => model.Airlinename)</th>
                        <th>@Html.DisplayNameFor(model => model.BaseAirport)</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-soft-neutral">@Html.DisplayFor(modelItem => item.Iata)</span></td>
                            <td>@Html.DisplayFor(modelItem => item.Airlinename)</td>
                            <td>@Html.DisplayFor(modelItem => item.BaseAirport)</td>
                            <td class="actions-cell text-end">
                                <a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@item.AirlineId">Detalles</a>
                                <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@item.AirlineId">Editar</a>
                                <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.AirlineId">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_Paginacion" model="pag" />
}
