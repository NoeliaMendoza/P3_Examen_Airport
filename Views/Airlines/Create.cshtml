@model AirportApp.Models.Airline

@{
    ViewData["Title"] = "Nueva aerolínea";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Aerolíneas</a></li>
        <li class="breadcrumb-item active" aria-current="page">Nueva aerolínea</li>
    </ol>
</nav>

<div class="page-header">
    <h1>Nueva aerolínea</h1>
    <p class="lead-muted">Registra una aerolínea en el catálogo.</p>
</div>

<div class="row">
    <div class="col-md-7 col-lg-6">
        <div class="table-card p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Iata" class="form-label"></label>
                    <input asp-for="Iata" class="form-control" />
                    <span asp-validation-for="Iata" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Airlinename" class="form-label"></label>
                    <input asp-for="Airlinename" class="form-control" />
                    <span asp-validation-for="Airlinename" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="BaseAirport" class="form-label"></label>
                    <input asp-for="BaseAirport" class="form-control" />
                    <span asp-validation-for="BaseAirport" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-icon"><i class="bi bi-check-lg"></i>Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary btn-icon"><i class="bi bi-arrow-left"></i>Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
