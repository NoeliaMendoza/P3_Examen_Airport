@model AirportApp.Models.Airline

@{
    ViewData["Title"] = "Eliminar aerolínea";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Aerolíneas</a></li>
        <li class="breadcrumb-item active" aria-current="page">Eliminar aerolínea</li>
    </ol>
</nav>

<div class="page-header">
    <h1>Eliminar aerolínea</h1>
    <p class="lead-muted">Esta acción no se puede deshacer.</p>
</div>

<div class="table-card p-4" style="max-width: 44rem;">
    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-triangle mt-1"></i>
        <div>¿Estás seguro de que deseas eliminar la aerolínea <strong>@Html.DisplayFor(model => model.Airlinename)</strong>?</div>
    </div>

    <div class="detail-list mb-4">
        <div class="detail-item">
            <dt>@Html.DisplayNameFor(model => model.Iata)</dt>
            <dd>@Html.DisplayFor(model => model.Iata)</dd>
        </div>
        <div class="detail-item">
            <dt>@Html.DisplayNameFor(model => model.Airlinename)</dt>
            <dd>@Html.DisplayFor(model => model.Airlinename)</dd>
        </div>
        <div class="detail-item">
            <dt>@Html.DisplayNameFor(model => model.BaseAirport)</dt>
            <dd>@Html.DisplayFor(model => model.BaseAirport)</dd>
        </div>
    </div>

    <form asp-action="Delete" class="d-flex gap-2">
        <input type="hidden" asp-for="AirlineId" />
        <button type="submit" class="btn btn-danger btn-icon"><i class="bi bi-trash"></i>Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary btn-icon"><i class="bi bi-arrow-left"></i>Cancelar</a>
    </form>
</div>
