@model AirportApp.Models.Airline

@{
    ViewData["Title"] = "Detalles de la aerolínea";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Aerolíneas</a></li>
        <li class="breadcrumb-item active" aria-current="page">Detalles</li>
    </ol>
</nav>

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1>Detalles de la aerolínea <span class="badge bg-soft-neutral">@Html.DisplayFor(model => model.Iata)</span></h1>
        <p class="lead-muted">Información completa de la aerolínea.</p>
    </div>
    <a asp-action="Edit" asp-route-id="@Model?.AirlineId" class="btn btn-secondary btn-icon">
        <i class="bi bi-pencil"></i>Editar
    </a>
</div>

<div class="table-card p-4">
    <div class="detail-list">
        <div class="detail-item">
            <dt>@Html.DisplayNameFor(model => model.Iata)</dt>
            <dd>@Html.DisplayFor(model => model.Iata)</dd>
        </div>
        <div class="detail-item">
            <dt>@Html.DisplayNameFor(model => model.Airlinename)</dt>
            <dd>@Html.DisplayFor(model => model.Airlinename)</dd>
        </div>
        <div class="detail-item">
            <dt>@Html.DisplayNameFor(model => model.BaseAirport)</dt>
            <dd>@Html.DisplayFor(model => model.BaseAirport)</dd>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary btn-icon"><i class="bi bi-arrow-left"></i>Volver a la lista</a>
</div>
