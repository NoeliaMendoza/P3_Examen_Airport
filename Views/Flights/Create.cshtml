@model AirportApp.Models.Flight

@{
    ViewData["Title"] = "Nuevo vuelo";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Vuelos</a></li>
        <li class="breadcrumb-item active" aria-current="page">Nuevo vuelo</li>
    </ol>
</nav>

<div class="page-header">
    <h1>Nuevo vuelo</h1>
    <p class="lead-muted">Registra un vuelo en la programación.</p>
</div>

<div class="row">
    <div class="col-md-7 col-lg-6">
        <div class="table-card p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Flightno" class="form-label"></label>
                    <select asp-for="Flightno" class="form-select" asp-items="ViewBag.Flightno"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="From" class="form-label"></label>
                    <select asp-for="From" class="form-select" asp-items="ViewBag.From"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="To" class="form-label"></label>
                    <select asp-for="To" class="form-select" asp-items="ViewBag.To"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="Departure" class="form-label"></label>
                    <input asp-for="Departure" class="form-control" />
                    <span asp-validation-for="Departure" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Arrival" class="form-label"></label>
                    <input asp-for="Arrival" class="form-control" />
                    <span asp-validation-for="Arrival" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="AirlineId" class="form-label"></label>
                    <select asp-for="AirlineId" class="form-select" asp-items="ViewBag.AirlineId"></select>
                </div>
                <div class="mb-4">
                    <label asp-for="AirplaneId" class="form-label"></label>
                    <select asp-for="AirplaneId" class="form-select" asp-items="ViewBag.AirplaneId"></select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-icon"><i class="bi bi-check-lg"></i>Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary btn-icon"><i class="bi bi-arrow-left"></i>Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
