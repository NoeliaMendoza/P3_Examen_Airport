@model AirportApp.Models.Flight

@{
    ViewData["Title"] = "Eliminar vuelo";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Vuelos</a></li>
        <li class="breadcrumb-item active" aria-current="page">Eliminar vuelo</li>
    </ol>
</nav>

<div class="page-header">
    <h1>Eliminar vuelo</h1>
    <p class="lead-muted">Esta acción no se puede deshacer.</p>
</div>

<div class="table-card p-4" style="max-width: 44rem;">
    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-triangle mt-1"></i>
        <div>¿Estás seguro de que deseas eliminar el vuelo <strong>@Model.Flightno</strong>?</div>
    </div>

    <div class="detail-list mb-4">
        <div class="detail-item">
            <dt>Salida</dt>
            <dd>@Html.DisplayFor(model => model.Departure)</dd>
        </div>
        <div class="detail-item">
            <dt>Llegada</dt>
            <dd>@Html.DisplayFor(model => model.Arrival)</dd>
        </div>
        <div class="detail-item">
            <dt>Aerolínea</dt>
            <dd>@Html.DisplayFor(model => model.Airline.AirlineId)</dd>
        </div>
        <div class="detail-item">
            <dt>Aeronave</dt>
            <dd>@Html.DisplayFor(model => model.Airplane.AirplaneId)</dd>
        </div>
        <div class="detail-item">
            <dt>Número</dt>
            <dd>@Html.DisplayFor(model => model.FlightnoNavigation.Flightno)</dd>
        </div>
        <div class="detail-item">
            <dt>Origen</dt>
            <dd>@Html.DisplayFor(model => model.FromNavigation.AirportId)</dd>
        </div>
        <div class="detail-item">
            <dt>Destino</dt>
            <dd>@Html.DisplayFor(model => model.ToNavigation.AirportId)</dd>
        </div>
    </div>

    <form asp-action="Delete" class="d-flex gap-2">
        <input type="hidden" asp-for="FlightId" />
        <button type="submit" class="btn btn-danger btn-icon"><i class="bi bi-trash"></i>Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary btn-icon"><i class="bi bi-arrow-left"></i>Cancelar</a>
    </form>
</div>
