@model IEnumerable<AirportApp.Models.Flight>
@using AirportApp.ViewModels

@{
    ViewData["Title"] = "Vuelos";
    var pag = ViewBag.Paginacion as PaginacionViewModel;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Vuelos</li>
    </ol>
</nav>

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1>Vuelos</h1>
        <p class="lead-muted">Explora la programación de vuelos y selecciona un asiento.</p>
    </div>
</div>

<div class="filter-panel">
    <form asp-action="Index" method="get">
        <div class="row g-3">
            <div class="col-md-2">
                <label class="form-label" for="buscar">Buscar</label>
                <div class="search-input">
                    <i class="bi bi-search"></i>
                    <input type="text" id="buscar" name="buscar" value="@pag?.Buscar"
                           class="form-control" placeholder="Número de vuelo o IATA (origen/destino)" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="filtro1">Aerolínea</label>
                <select id="filtro1" name="filtro1" class="form-select">
                    <option value="">Todas las aerolíneas</option>
                    @foreach (var a in ViewBag.Aerolineas)
                    {
                        <option value="@a.Value" selected="@(pag?.Filtro1 == a.Value)">@a.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="filtro2">Fecha de salida</label>
                <input type="date" id="filtro2" name="filtro2" value="@pag?.Filtro2" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="orden">Ordenar por</label>
                <select id="orden" name="orden" class="form-select">
                    <option value="salida" selected="@(pag?.Orden == "salida" || pag?.Orden == null)">Salida</option>
                    <option value="llegada" selected="@(pag?.Orden == "llegada")">Llegada</option>
                    <option value="duracion" selected="@(pag?.Orden == "duracion")">Duración</option>
                </select>
            </div>
            <div class="col-md-2 d-flex flex-column gap-2 justify-content-end">
                <button type="submit" class="btn btn-primary btn-icon">
                    <i class="bi bi-funnel"></i>Filtrar
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-icon">
                    <i class="bi bi-arrow-counterclockwise"></i>Limpiar
                </a>
            </div>
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <div class="table-card">
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-airplane"></i></div>
            <h5>Sin resultados</h5>
            <p>No se encontraron vuelos con los criterios indicados. Ajusta los filtros e inténtalo de nuevo.</p>
            <a asp-action="Index" class="btn btn-secondary btn-sm">Limpiar filtros</a>
        </div>
    </div>
}
else
{
    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Vuelo</th>
                        <th>Salida</th>
                        <th>Llegada</th>
                        <th>Ruta</th>
                        <th>Aerolínea</th>
                        <th>Aeronave</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-soft-neutral">@item.Flightno</span></td>
                            <td>@item.Departure</td>
                            <td>@item.Arrival</td>
                            <td>
                                <span class="d-inline-flex align-items-center gap-1">
                                    <span class="badge bg-soft-primary">@item.FromNavigation?.Iata</span>
                                    <i class="bi bi-arrow-right text-muted small"></i>
                                    <span class="badge bg-soft-primary">@item.ToNavigation?.Iata</span>
                                </span>
                            </td>
                            <td>@item.Airline?.Airlinename</td>
                            <td><span class="text-muted small">@item.Airplane?.AirplaneId · cap. @item.Airplane?.Capacity</span></td>
                            <td class="actions-cell text-end">
                                <a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@item.FlightId">Detalles</a>
                                <a class="btn btn-primary btn-sm" asp-controller="Reservas" asp-action="Asientos" asp-route-id="@item.FlightId">Asientos</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_Paginacion" model="pag" />
}
