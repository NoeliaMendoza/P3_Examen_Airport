@model IEnumerable<AirportApp.Models.Flight>
@using AirportApp.ViewModels

@{
    ViewData["Title"] = "Vuelos";
    var pag = ViewBag.Paginacion as PaginacionViewModel;
}

<h1>Vuelos</h1>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-4">
            <input type="text" name="buscar" value="@pag?.Buscar"
                   class="form-control" placeholder="Buscar por vuelo o código IATA (origen/destino)" />
        </div>
        <div class="col-md-3">
            <select name="filtro1" class="form-select">
                <option value="">Todas las aerolíneas</option>
                @foreach (var a in ViewBag.Aerolineas)
                {
                    <option value="@a.Value" selected="@(pag?.Filtro1 == a.Value)">@a.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <input type="date" name="filtro2" value="@pag?.Filtro2" class="form-control" />
        </div>
        <div class="col-md-2">
            <select name="orden" class="form-select">
                <option value="salida" selected="@(pag?.Orden == "salida" || pag?.Orden == null)">Salida</option>
                <option value="salida_desc" selected="@(pag?.Orden == "salida_desc")">Salida ↓</option>
                <option value="llegada" selected="@(pag?.Orden == "llegada")">Llegada</option>
                <option value="duracion" selected="@(pag?.Orden == "duracion")">Duración</option>
            </select>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        </div>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Flightno)</th>
            <th>Salida</th>
            <th>Llegada</th>
            <th>Ruta</th>
            <th>@Html.DisplayNameFor(model => model.Airline)</th>
            <th>Aeronave</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Flightno)</td>
            <td>@Html.DisplayFor(modelItem => item.Departure)</td>
            <td>@Html.DisplayFor(modelItem => item.Arrival)</td>
            <td>@item.FromNavigation?.Iata → @item.ToNavigation?.Iata</td>
            <td>@item.Airline?.Airlinename</td>
            <td>@item.Airplane?.AirplaneId (cap. @item.Airplane?.Capacity)</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.FlightId">Detalles</a>
            </td>
        </tr>
}
    </tbody>
</table>

<partial name="_Paginacion" model="pag" />
