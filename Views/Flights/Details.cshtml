@model AirportApp.Models.Flight

@{
    ViewData["Title"] = "Detalles del vuelo";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Vuelos</a></li>
        <li class="breadcrumb-item active" aria-current="page">Detalles</li>
    </ol>
</nav>

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1>Detalles del vuelo <span class="badge bg-soft-primary">@Model.Flightno</span></h1>
        <p class="lead-muted">Información completa del vuelo.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model?.FlightId" class="btn btn-secondary btn-icon">
            <i class="bi bi-pencil"></i>Editar
        </a>
        <a asp-controller="Reservas" asp-action="Asientos" asp-route-id="@Model?.FlightId" class="btn btn-primary btn-icon">
            <i class="bi bi-grid-3x3-gap"></i>Seleccionar asiento
        </a>
    </div>
</div>

<div class="table-card p-4">
    <div class="detail-list">
        <div class="detail-item">
            <dt>Salida</dt>
            <dd>@Html.DisplayFor(model => model.Departure)</dd>
        </div>
        <div class="detail-item">
            <dt>Llegada</dt>
            <dd>@Html.DisplayFor(model => model.Arrival)</dd>
        </div>
        <div class="detail-item">
            <dt>Aerolínea</dt>
            <dd>@Html.DisplayFor(model => model.Airline.AirlineId)</dd>
        </div>
        <div class="detail-item">
            <dt>Aeronave</dt>
            <dd>@Html.DisplayFor(model => model.Airplane.AirplaneId)</dd>
        </div>
        <div class="detail-item">
            <dt>Número</dt>
            <dd>@Html.DisplayFor(model => model.FlightnoNavigation.Flightno)</dd>
        </div>
        <div class="detail-item">
            <dt>Origen</dt>
            <dd>@Html.DisplayFor(model => model.FromNavigation.AirportId)</dd>
        </div>
        <div class="detail-item">
            <dt>Destino</dt>
            <dd>@Html.DisplayFor(model => model.ToNavigation.AirportId)</dd>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary btn-icon"><i class="bi bi-arrow-left"></i>Volver a la lista</a>
</div>
