@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="table-card empty-state fade-in" style="max-width: 34rem; margin: 3rem auto;">
    <div class="empty-icon" style="background-color: #FEF2F2; color: var(--p-color-danger);">
        <i class="bi bi-exclamation-triangle"></i>
    </div>
    <h5>Ups, algo salió mal</h5>
    <p>Ocurrió un error al procesar tu solicitud. Inténtalo de nuevo o vuelve al inicio.</p>

    @if (Model.ShowRequestId)
    {
        <div class="small text-muted mb-3">
            ID de solicitud: <code>@Model.RequestId</code>
        </div>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-icon">
        <i class="bi bi-house-door"></i>Volver al inicio
    </a>
</div>

@if (Model.ShowRequestId)
{
    <div class="mt-3">
        <h6 class="text-muted">Modo de desarrollo</h6>
        <p class="small text-muted">
            Para ver información detallada del error, habilita el entorno <strong>Development</strong> en
            <code>ASPNETCORE_ENVIRONMENT</code>. El modo de desarrollo no debe activarse en producción.
        </p>
    </div>
}
