@model AirportApp.Models.Passenger

@{
    ViewData["Title"] = "Nuevo pasajero";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Pasajeros</a></li>
        <li class="breadcrumb-item active" aria-current="page">Nuevo pasajero</li>
    </ol>
</nav>

<div class="page-header">
    <h1>Nuevo pasajero</h1>
    <p class="lead-muted">Registra un pasajero en el sistema.</p>
</div>

<div class="row">
    <div class="col-md-7 col-lg-6">
        <div class="table-card p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="PassengerId" class="form-label"></label>
                    <input asp-for="PassengerId" class="form-control" />
                    <span asp-validation-for="PassengerId" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Passportno" class="form-label"></label>
                    <input asp-for="Passportno" class="form-control" />
                    <span asp-validation-for="Passportno" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Firstname" class="form-label"></label>
                    <input asp-for="Firstname" class="form-control" />
                    <span asp-validation-for="Firstname" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Lastname" class="form-label"></label>
                    <input asp-for="Lastname" class="form-control" />
                    <span asp-validation-for="Lastname" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-icon"><i class="bi bi-check-lg"></i>Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary btn-icon"><i class="bi bi-arrow-left"></i>Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
