@model IEnumerable<AirportApp.Models.Passenger>
@using AirportApp.ViewModels

@{
    ViewData["Title"] = "Pasajeros";
    var pag = ViewBag.Paginacion as PaginacionViewModel;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Pasajeros</li>
    </ol>
</nav>

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1>Pasajeros</h1>
        <p class="lead-muted">Consulta el registro de pasajeros del aeropuerto.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-icon">
        <i class="bi bi-plus-lg"></i>Nuevo pasajero
    </a>
</div>

<div class="filter-panel">
    <form asp-action="Index" method="get">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="buscar">Buscar</label>
                <div class="search-input">
                    <i class="bi bi-search"></i>
                    <input type="text" id="buscar" name="buscar" value="@pag?.Buscar"
                           class="form-control" placeholder="Buscar por pasaporte, nombre o apellido" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="orden">Ordenar por</label>
                <select id="orden" name="orden" class="form-select">
                    <option value="id" selected="@(pag?.Orden == "id" || pag?.Orden == null)">ID</option>
                    <option value="apellido" selected="@(pag?.Orden == "apellido")">Apellido</option>
                    <option value="pasaporte" selected="@(pag?.Orden == "pasaporte")">Pasaporte</option>
                </select>
            </div>
            <div class="col-md-3 d-flex flex-column gap-2 justify-content-end">
                <button type="submit" class="btn btn-primary btn-icon">
                    <i class="bi bi-funnel"></i>Filtrar
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-icon">
                    <i class="bi bi-arrow-counterclockwise"></i>Limpiar
                </a>
            </div>
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <div class="table-card">
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-person-badge"></i></div>
            <h5>Sin resultados</h5>
            <p>No se encontraron pasajeros con los criterios indicados. Ajusta los filtros e inténtalo de nuevo.</p>
            <a asp-action="Index" class="btn btn-secondary btn-sm">Limpiar filtros</a>
        </div>
    </div>
}
else
{
    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Passportno)</th>
                        <th>@Html.DisplayNameFor(model => model.Firstname)</th>
                        <th>@Html.DisplayNameFor(model => model.Lastname)</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-soft-neutral">@Html.DisplayFor(modelItem => item.Passportno)</span></td>
                            <td>@Html.DisplayFor(modelItem => item.Firstname)</td>
                            <td>@Html.DisplayFor(modelItem => item.Lastname)</td>
                            <td class="actions-cell text-end">
                                <a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@item.PassengerId">Detalles</a>
                                <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@item.PassengerId">Editar</a>
                                <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.PassengerId">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_Paginacion" model="pag" />
}
