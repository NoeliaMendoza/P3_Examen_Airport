@inject SignInManager<IdentityUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<ul class="nav nav-pills flex-column gap-1">
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.IndexNavClass(ViewContext) d-flex align-items-center gap-2" id="profile" asp-page="./Index">
            <i class="bi bi-person"></i>Perfil
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.EmailNavClass(ViewContext) d-flex align-items-center gap-2" id="email" asp-page="./Email">
            <i class="bi bi-envelope"></i>Correo electrónico
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext) d-flex align-items-center gap-2" id="change-password" asp-page="./ChangePassword">
            <i class="bi bi-shield-lock"></i>Contraseña
        </a>
    </li>
    @if (hasExternalLogins)
    {
        <li id="external-logins" class="nav-item">
            <a id="external-login" class="nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext) d-flex align-items-center gap-2" asp-page="./ExternalLogins">
                <i class="bi bi-plug"></i>Inicios de sesión externos
            </a>
        </li>
    }
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext) d-flex align-items-center gap-2" id="two-factor" asp-page="./TwoFactorAuthentication">
            <i class="bi bi-phone"></i>Autenticación de dos factores
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.PersonalDataNavClass(ViewContext) d-flex align-items-center gap-2" id="personal-data" asp-page="./PersonalData">
            <i class="bi bi-person-lines-fill"></i>Datos personales
        </a>
    </li>
</ul>
