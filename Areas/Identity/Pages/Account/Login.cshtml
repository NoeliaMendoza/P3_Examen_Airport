@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="auth-wrapper">
    <div class="auth-card fade-in">
        <div class="auth-logo"><i class="bi bi-airplane"></i></div>
        <h1>Bienvenido de nuevo</h1>
        <p class="auth-subtitle">Ingresa a tu cuenta para gestionar tus reservas.</p>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                <div class="search-input">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@espe.edu.ec" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Contraseña</label>
                <div class="search-input">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe" class="form-check-label small text-muted">Recordarme</label>
            </div>
            <button id="login-submit" type="submit" class="w-100 btn btn-primary btn-icon justify-content-center">
                <i class="bi bi-box-arrow-in-right"></i>Ingresar
            </button>
        </form>

        <hr class="my-4" style="border-color: var(--p-color-border);" />
        <div class="text-center small">
            <p class="mb-2 text-muted">¿Aún no tienes cuenta?</p>
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-secondary w-100 btn-icon justify-content-center">
                <i class="bi bi-person-plus"></i>Crear cuenta
            </a>
            <p class="mt-3 mb-0">
                <a id="forgot-password" asp-page="./ForgotPassword" class="link-secondary text-decoration-none">¿Olvidaste tu contraseña?</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
